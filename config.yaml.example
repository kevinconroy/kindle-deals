# Kindle Deals Monitor Configuration
# Copy this file to config.yaml and customize for your setup

amazon:
  domain: "amazon.com"

database:
  host: "localhost"
  user: "root"
  database: "kindle_deals"
  password: ""

storage:
  browser_session_path: "~/.kindle-deals/browser-session"

email:
  smtp_server: "smtp.mail.me.com"
  smtp_port: 587
  from_address: "you@icloud.com"
  to_address: "you@gmail.com"
  password: "xxxx-xxxx-xxxx-xxxx"  # iCloud app-specific password
  subject_template: "Kindle Deal Alert: {title}"

deals:
  max_price: 4.00
  min_discount_percent: 50
  notification_cooldown_days: 30
  recommendation_concurrency: 3  # number of parallel browser tabs for recommendation checking

auto_purchase:
  enabled: true                       # auto-buy eligible samples with 1-Click
  max_price: 5.00                     # only auto-buy at or below this price
  require_points_full_coverage: true  # only buy when Rewards points cover the whole price
  max_purchases_per_run: 5            # safety cap on purchases per run

scraping:
  headless: true
  page_load_timeout: 30000
  element_timeout: 10000
  check_delay: 2000
  action_delay: 500

sync:
  collection_name: "Read Me 2026"    # Collection to auto-add uncollected samples to
  early_stop_threshold: 10           # Stop after this many consecutive known ASINs
